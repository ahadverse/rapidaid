generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DRIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AmbulanceType {
  BASIC
  AC
  ICU
  FREEZER
}

enum AmbulanceStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum RequestStatus {
  PENDING
  DISPATCHED
  COMPLETED
  CANCELLED
  NO_AMBULANCE_AVAILABLE
}

enum TripStatus {
  DISPATCHED
  EN_ROUTE_TO_PICKUP
  PATIENT_PICKED_UP
  EN_ROUTE_TO_HOSPITAL
  ARRIVED_AT_HOSPITAL
  COMPLETED
  CANCELLED
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String?
  googleId  String?    @unique
  phone     String?
  role      Role       @default(PATIENT)
  status    UserStatus @default(ACTIVE)
  isDeleted Boolean    @default(false)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  driverProfile     DriverProfile?
  emergencyRequests EmergencyRequest[]

  @@index([role])
  @@index([status])
  @@index([isDeleted])
  @@map("users")
}

model DriverProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  licenseNumber String   @unique
  nid           String   @unique
  isAvailable   Boolean  @default(false)
  ambulanceId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ambulance Ambulance? @relation(fields: [ambulanceId], references: [id], onDelete: SetNull)
  trips     Trip[]

  @@index([isAvailable])
  @@index([ambulanceId])
  @@map("driver_profiles")
}

model Ambulance {
  id          String          @id @default(uuid())
  regNumber   String          @unique
  type        AmbulanceType   @default(BASIC)
  status      AmbulanceStatus @default(AVAILABLE)
  baseFare    Decimal         @db.Decimal(10, 2)
  perKmRate   Decimal         @db.Decimal(10, 2)
  stationArea String
  isDeleted   Boolean         @default(false)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  drivers DriverProfile[]
  trips   Trip[]

  @@index([status])
  @@index([type])
  @@index([stationArea])
  @@index([isDeleted])
  @@map("ambulances")
}

model Hospital {
  id              String    @id @default(uuid())
  name            String
  address         String
  area            String
  phone           String
  specializations String[]
  availableBeds   Int       @default(0)
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  trips Trip[]

  @@index([area])
  @@index([name])
  @@index([isDeleted])
  @@map("hospitals")
}

model EmergencyRequest {
  id                     String         @id @default(uuid())
  patientId              String
  pickupAddress          String
  pickupLat              Float?
  pickupLng              Float?
  patientCondition       String
  priority               Priority       @default(MEDIUM)
  status                 RequestStatus  @default(PENDING)
  requestedAmbulanceType AmbulanceType?
  cancelReason           String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  patient User  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  trip    Trip?

  @@index([status])
  @@index([priority])
  @@index([patientId])
  @@index([status, priority, createdAt])
  @@map("emergency_requests")
}

model Trip {
  id           String     @id @default(uuid())
  requestId    String     @unique
  ambulanceId  String
  driverId     String
  hospitalId   String?
  status       TripStatus @default(DISPATCHED)
  distanceKm   Decimal?   @db.Decimal(6, 2)
  fare         Decimal?   @db.Decimal(10, 2)
  cancelReason String?
  dispatchedAt DateTime   @default(now())
  pickedUpAt   DateTime?
  arrivedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  request   EmergencyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  ambulance Ambulance        @relation(fields: [ambulanceId], references: [id], onDelete: Restrict)
  driver    DriverProfile    @relation(fields: [driverId], references: [id], onDelete: Restrict)
  hospital  Hospital?        @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([driverId])
  @@index([ambulanceId])
  @@index([hospitalId])
  @@map("trips")
}
