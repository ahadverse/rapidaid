{
  "name": "rapidaid-api",
  "version": "1.0.0",
  "description": "RapidAid — Emergency Response Platform. Priority-based ambulance dispatch backend, from emergency call to hospital arrival.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/server.js"
  },
  "keywords": [
    "ambulance",
    "dispatch",
    "emergency",
    "express",
    "typescript",
    "prisma"
  ],
  "author": "Ahad Hossain",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "cross-env": "^10.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
