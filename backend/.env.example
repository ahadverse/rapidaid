# Copy to .env.development (or .env.production) and fill in real values.

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@host:5432/rapidaid_db?sslmode=require

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# SSLCommerz (sandbox)
SSL_STORE_ID=
SSL_STORE_PASS=
SSL_PAYMENT_API=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSL_VALIDATION_API=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
SSL_SUCCESS_URL=http://localhost:5000/api/v1/payments/success
SSL_FAIL_URL=http://localhost:5000/api/v1/payments/fail
SSL_CANCEL_URL=http://localhost:5000/api/v1/payments/cancel
SSL_IPN_URL=http://localhost:5000/api/v1/payments/ipn

# Seed / demo accounts
ADMIN_EMAIL=admin@rapidaid.com
ADMIN_PASSWORD=
SEED_PASSWORD=
